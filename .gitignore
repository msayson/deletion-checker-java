# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ...except the Gradle wrapper jar, which must be committed so `./gradlew` works on a clean checkout
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Generated datasets are release artifacts (~400 MB), not source; keep the directory
/data/*
!/data/.gitkeep

# Ignore local Claude settings
.claude/settings.local.json
